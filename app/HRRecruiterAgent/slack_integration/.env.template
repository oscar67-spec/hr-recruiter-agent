# Slack Integration Environment Variables
# Copy this to .env and fill in your actual values

# Slack Tokens (Get from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# AWS Configuration (same as main agent)
AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# S3 Storage (same as main agent)
HR_S3_BUCKET=hr-recruiter-agent-data
HR_S3_PREFIX=hr-agent
