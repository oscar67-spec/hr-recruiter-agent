{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "HRRecruiterAgentNew",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "HRRecruiterAgentNew"
  },
  "runtimes": [
    {
      "name": "HRRecruiterAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/HRRecruiterAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "HRRecruiterMemory",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "SEMANTIC",
          "description": "Stores facts about candidates, job roles, screening outcomes, and recruiter preferences so the agent can recall them across sessions"
        },
        {
          "type": "SUMMARIZATION",
          "description": "Creates rolling summaries of hiring pipeline conversations for quick recall in future sessions"
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}